PORT=3000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/wings

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_key
ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key
REFRESH_TOKEN_EXPIRES_IN=7d

# OTP Configuration
OTP_EXPIRES_IN=5m
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_RESEND_WINDOW_MINUTES=15

# Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="WINGS <wings.platform@gmail.com>"

# AWS S3 Video Storage Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=wings-exercise-media
AWS_S3_VIDEO_PREFIX=exercise-videos/
AWS_S3_THUMBNAIL_PREFIX=exercise-thumbnails/
AWS_S3_PROCESSED_PREFIX=processed-exercises/
AWS_CLOUDFRONT_DOMAIN=

